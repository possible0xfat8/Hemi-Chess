# Admin Wallets (comma-separated)
ADMIN_WALLETS=0xYourAdminWalletAddress

# Server Port
PORT=3000

# Backend Oracle Wallet (for on-chain settlement)
# Export from MetaMask: Settings > Security & Privacy > Show Private Key
BACKEND_PRIVATE_KEY=0xYourPrivateKeyHere

# HemiChessElo Smart Contract Address (deployed on Hemi Sepolia)
HEMI_CHESS_ELO_ADDRESS=0xYourContractAddressHere

# Supabase Configuration (uses HTTPS - works everywhere!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Cloudflare R2 Storage (for avatar uploads)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=hemi-profile-storage
R2_PUBLIC_URL=https://your-r2-bucket-url.r2.dev

# Backend URL (for CORS - will be your Railway URL)
BACKEND_URL=https://your-app.up.railway.app
